        "\n",
        "        \\vfill \n",
        "    \\end{center}\n",
        "\n",
        "    \\begin{flushright}\n",
        "        \\large\n",
        "        Nome: Joenyr P. C. Domingues \\\\\n",
        "        NUSP: 15464382 \\\\\n",
        "    \\end{flushright}\n",
        "\n",
        "    \\vspace{4cm}\n",
        "\n",
        "    \\begin{center}\n",
        "        \\large São Carlos \\\\\n",
        "        \\large 13/04/2026\n",
        "    \\end{center}\n",
