        "\\begin{titlepage}\n",
        "    \\begin{center}\n",
        "        \\includegraphics[height=2.6cm]{ifsc.jpg}\\hspace{0.3cm} \\\\\n",
        "        \\large \\textbf{INSTITUTO DE FÍSICA DE SÃO CARLOS} \\\\\n",
